│   └── contract/             # core 네트워크 금지 등 계약 테스트
├── scripts/                  # 보조 스크립트·fixture 생성기
│   └── fixtures/
├── docs/                     # 설계·워크플로·배포·작업 일지
│   ├── FMS_RECALIBRATION_WORKFLOW.md
│   ├── DEPLOYMENT.md
│   ├── CONTRIBUTING.md
│   ├── README_BATCH.md
│   └── work-plans/           # 세션별 작업 일지
├── cache/                    # [gitignore] 런타임 market_data parquet (운영 미커밋)
├── pytest.ini                # pytest 설정
├── watchlist_free.csv        # 자유투자계좌 관심종목 저장 파일
├── watchlist_irp.csv         # 퇴직연금IRP 관심종목 저장 파일
